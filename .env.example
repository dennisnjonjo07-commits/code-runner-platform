# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/code-runner
DB_NAME=code-runner

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# Redis (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
MAX_FILE_SIZE=50mb
UPLOAD_DIR=./uploads

# Execution
EXEC_TIMEOUT=60000
MAX_MEMORY=512m
MAX_CPU=100m

# Security
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:3000
