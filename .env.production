# .env.production
# Production environment variables (do NOT commit this file)
# Use this template and update values for your production environment

NODE_ENV=production
PORT=5000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_generate_with_openssl_rand_base64_32
JWT_EXPIRE=7d

# Database (if using MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/code-runner?retryWrites=true&w=majority
DB_NAME=code-runner

# CORS
CORS_ORIGIN=https://your-production-domain.com

# Code Execution
EXEC_TIMEOUT=60000
MAX_MEMORY=512m
MAX_CPU=100m

# File Upload
MAX_FILE_SIZE=50mb
UPLOAD_DIR=/var/uploads

# Security
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=info

# Email (optional, for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
